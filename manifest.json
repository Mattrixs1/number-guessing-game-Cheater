{
  "manifest_version": 3,
  "name": "Number Guess Cheater 🎯",
  "version": "1.0",
  "description": "Zeigt den Wert von numberToGuess auf deiner Seite an",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  }
}
